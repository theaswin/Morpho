<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_organisation_wizard_form" model="ir.ui.view">
        <field name="name">create.organisation.wizard.form</field>
        <field name="model">create.organisation.wizard</field>
        <field name="arch" type="xml">
            <form string="Create New Organisation">
                <sheet>
                    <group>
                        <group string="Organisation Details">
                            <field name="name"/>
                            <field name="vat"/>
                            <field name="location"/>
                            <field name="mobile"/>
                        </group>
                        <group string="Owner Details">
                            <field name="owner_name"/>
                            <field name="owner_email"/>
                            <field name="owner_phone"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_organisation_wizard" model="ir.actions.act_window">
        <field name="name">Create New Organisation</field>
        <field name="res_model">create.organisation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
