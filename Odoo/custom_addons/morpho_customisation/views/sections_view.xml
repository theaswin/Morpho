<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- list/List View -->
    <record id="view_section_sections_list" model="ir.ui.view">
        <field name="name">section.sections.list</field>
        <field name="model">section.sections</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="organisation_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_section_sections_form" model="ir.ui.view">
        <field name="name">section.sections.form</field>
        <field name="model">section.sections</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="organisation_id"/>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Code">
                            <field name="code"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_section_sections" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">section.sections</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
