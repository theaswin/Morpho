<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_inherit_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.organisation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Morpho">
                    <group>
                        <group>
                            <field name="organisation_id" domain="[('is_company','=',True)]" />
                            <field name="owner_id" invisible="is_company == False"/>
                            <field name="support_id" invisible="is_company == False"/>
                        </group>
                        <group>
                            <field name="validity_till" readonly="0"/>
                            <field name="valid_days"/>
                            <field name="status"/>
                            <field name="create_uid" readonly="0"/>
                            <field name="write_uid" readonly="0"/>

                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_partner_list_inherit_morpho" model="ir.ui.view">
        <field name="name">res.partner.list.inherit.organisation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="owner_id"/>
                <field name="support_id"/>
                <field name="validity_till"/>
                <field name="valid_days" invisible="1"/>
                <field name="status" widget="badge" 
                    decoration-success="status == 'active'"
                    decoration-info="status == 'in_progress'"
                    decoration-danger="status == 'expired'"
                    decoration-warning="status == 'expiring'" 
                />
                <field name='is_company'/>

            </xpath>

        </field>
    </record>
        

    <record id="action_organisation" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=',True)]</field>
        <field name="context">{}</field>
    </record>
    <record id="action_client_contact" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=',False)]</field>
        <field name="context">{}</field>
    </record>
</odoo>








