<!-- morpho_backend_views.xml -->
<odoo>
    <!-- Tree (List) View -->
    <record id="view_morpho_backend_tree" model="ir.ui.view">
        <field name="name">morpho.backend.list</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <list string="Morpho Backends">
                <field name="name"/>
                <field name="website"/>
                <field name="status" widget="badge" 
                decoration-info="status == 'draft'"
                decoration-success="status == 'live'"
                decoration-danger="status == 'archived'"
                />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_morpho_backend_form" model="ir.ui.view">
        <field name="name">morpho.backend.form</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <form string="Morpho Backend">
                <sheet>
                <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="website"/>
                            <field name="status"/>
                        </group>
                        <group>
                        </group>
                    </group>

                    <notebook>
                        <page string="Banner">
                            <group>
                                <group>
                                    <field name="header_image"/>
                                    <field name="header_align"/>
                                </group>
                                <group>
                                    <field name="head_content"/>
                                    <field name="head_content_align"/>

                                </group>
                            </group>
                            <group>
                                <field name="head_html"/>
                            </group>
                        </page>
                        <page string="Normal Sections">
                            <field name="sections_ids">
                                <form>
                                    <group>
                                        <group>
                                            <field name="image" widget="image"/>
                                            <field name="color"/>
                                        </group>
                                        <group>
                                            <field name="title"/>
                                            <field name="text"/>
                                        </group>
                                    </group>
                                </form>
                                <list>
                                    <field name="image"/>
                                    <field name="title"/>
                                    <field name="text"/>
                                    <field name="color"/>
                                </list>
                            </field>
                        </page>
                        <page string="Image Sections">
                            <field name="image_sections_ids">
                                
                                <list editable="bottom">
                                    <field name="title"/>
                                    <field name="image_ids" widget="many2many_tags" domain="[('mimetype','=','image/png')]"/>
                                    <field name="color"/>
                                </list>
                            </field>
                        </page>


                        <page string="Footer">
                            <group>
                                <group>
                                    <field name="f_image"/>
                                    <field name="f_html1"/>
                                </group>
                                <group>
                                    <field name="f_html2"/>
                                    <field name="f_html3"/>

                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_morpho_backend_kanban" model="ir.ui.view">
        <field name="name">morpho.backend.kanban</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="name">
                <field name="name"/>
                <field name="website"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="website"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_morpho_backend" model="ir.actions.act_window">
        <field name="name">Morpho Backend</field>
        <field name="res_model">morpho.backend</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <!-- Menu -->
</odoo>
