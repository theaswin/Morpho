<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree (List) View -->
    <record id="view_morpho_backend_tree" model="ir.ui.view">
        <field name="name">morpho.backend.list</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <list string="Morpho Backends">
                <field name="name"/>
                <field name="website"/>
                <field name="status" widget="badge" 
                decoration-info="status == 'draft'"
                decoration-success="status == 'live'"
                decoration-danger="status == 'archived'"
                />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_morpho_backend_form" model="ir.ui.view">
        <field name="name">morpho.backend.form</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <form string="Morpho Backend" >
            
                <header>
                        <field name="status" widget="statusbar" statusbar_buttons="True"/>
                            <button name="action_set_live" string="Live" type="object" class="btn-primary" invisible="status == 'live'"/>
                            <button name="action_set_inprogress" string="In Progress" type="object" class="btn-primary" invisible="status == 'in_progress'"/>
                            <button name="action_set_archived" string="Archived" type="object" class="btn-primary" invisible="status == 'archived'"/>
                </header>
                <sheet >
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_all_sections"
                            type="object"
                            string="Sections"
                            class="oe_stat_button"
                            icon="fa-cubes">
                        </button>
                    </div>

                <group>
                        <group>
                            <field name="name" required="1" readonly="status == 'live'"/>
                            <field name="is_generated" invisible="1"/>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                    <label for="website" string="Website"/>
                                    <field name="website" readonly="is_generated == True"/>
                                    <button name="create_refresh" type="object" string="🗘"  />
                            </div>
                        </group>
                        <group>
                            <field name="organisation_id" readonly="status == 'live'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Banner">
                            <group>
                                <group>
                                    <field name="header_image" readonly="status == 'live'"/>
                                    <field name="header_align" readonly="status == 'live'"/>
                                </group>
                                <group>
                                    <field name="head_content" readonly="status == 'live'" />
                                    <field name="head_content_align" readonly="status == 'live'" />

                                </group>
                            </group>
                            <group>
                                <field name="head_html" readonly="status == 'live'" />
                            </group>
                        </page>

                    <page string="Sections" id="all_sections_page" > 
                        <notebook>
                            <page string="General" id="general_sections"    >
                                <field name="general_sections_ids" readonly="status == 'live'" domain="[('section_id','=',1)]">
                                    <list string="General Sections" id="general_section_list" editable="bottom">
                                        <field name="section_id" readonly="0"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="design"/>
                                        <field name="image_ids" domain="[('mimetype','in',['image/png'])]" widget="many2many_tags"/>
                                        <field name="color"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Custom Sections tab -->
                            <page string="Customized" id="custom_sections"  readonly="status == 'live'">
                                <field name="general_sections_ids" readonly="status == 'live'" >
                                    <list string="General Sections" id="custom_section_list" editable="bottom">
                                        <field name="section_id" domain="[('id','>',1)]" readonly="0"/>
                                    </list>
                                </field>
                            </page>
                            <page string="All" id="all_sections">
                                <field name="general_sections_ids" >
                                    <list string="General Sections" id="custom_section_list" editable="bottom"
                                    create="false" edit="false" delete="false">
                                        <field name="sequence" widget="handle"/>
                                        <field name="sequence"/>
                                        <field name="section_id" readonly="0"/>
                                        <field name="title"/>
                                        <field name="description"/>
                                        <field name="design"/>
                                        <field name="image_ids" domain="[('mimetype','in',['image/png'])]" widget="many2many_tags"/>
                                        <field name="color"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </page>



                        <page string="Footer"  readonly="status == 'live'">
                            <group>
                                <group>
                                    <field name="f_image" readonly="status == 'live'" />
                                    <field name="f_html1" readonly="status == 'live'" />
                                </group>
                                <group>
                                    <field name="f_html2" readonly="status == 'live'" />
                                    <field name="f_html3" readonly="status == 'live'" />

                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_morpho_backend_kanban" model="ir.ui.view">
        <field name="name">morpho.backend.kanban</field>
        <field name="model">morpho.backend</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="name">
                <field name="name"/>
                <field name="website"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="website"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_morpho_backend" model="ir.actions.act_window">
        <field name="name">Morpho Backend</field>
        <field name="res_model">morpho.backend</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
