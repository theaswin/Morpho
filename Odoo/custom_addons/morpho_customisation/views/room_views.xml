<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hostel_room_kanban" model="ir.ui.view">
        <field name="name">hostel.room.kanban</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="room_number"/>
                <field name="organisation_id"/>
                <field name="vacancy_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title text-primary">
                                            <i class="fa fa-hospital mr-2"/>
                                            <field name="organisation_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mb-2">
                                        <strong>Room Number: </strong>
                                        <field name="room_number"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-muted">
                                            <i class="fa fa-bed mr-1"/>
                                            Vacancy
                                        </div>
                                        <span t-attf-class="font-weight-bold #{record.vacancy_count.raw_value > 0 ? 'text-success' : 'text-danger'}" style="font-size: 1.3rem;">
                                            <field name="vacancy_count"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hostel_room_form" model="ir.ui.view">
        <field name="name">hostel.room.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_number"/>
                        <field name="organisation_id"/>
                    </group>
                    <notebook invisible="not id">
                        <page string="Beds">
                            <field name="bed_ids">
                                <kanban>
                                    <field name="partner_id"/>
                                    <field name="partner_street"/>
                                    <field name="partner_city"/>
                                    <field name="partner_image"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click d-flex align-items-center justify-content-between p-2">
                                                <div class="o_kanban_record_body">
                                                    <div class="o_kanban_record_top">
                                                        <strong class="o_kanban_record_title">
                                                            <field name="partner_id"/>
                                                        </strong>
                                                    </div>
                                                    <div class="text-muted small">
                                                        <t t-if="record.partner_street.raw_value">
                                                            <field name="partner_street"/><br/>
                                                        </t>
                                                        <t t-if="record.partner_city.raw_value">
                                                            <field name="partner_city"/>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div class="o_kanban_record_right ml-2">
                                                    <field name="partner_image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'partner_image', 'size': [60, 60]}"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hostel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hostel.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
