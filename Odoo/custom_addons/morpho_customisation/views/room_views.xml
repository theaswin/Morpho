<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hostel_room_form" model="ir.ui.view">
        <field name="name">hostel.room.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_number"/>
                        <field name="organisation_id"/>
                    </group>
                    <notebook invisible="not id">
                        <page string="Beds">
                            <field name="bed_ids">
                                <kanban>
                                    <field name="partner_id"/>
                                    <field name="partner_street"/>
                                    <field name="partner_city"/>
                                    <field name="partner_image"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click d-flex align-items-center justify-content-between p-2">
                                                <div class="o_kanban_record_body">
                                                    <div class="o_kanban_record_top">
                                                        <strong class="o_kanban_record_title">
                                                            <field name="partner_id"/>
                                                        </strong>
                                                    </div>
                                                    <div class="text-muted small">
                                                        <t t-if="record.partner_street.raw_value">
                                                            <field name="partner_street"/><br/>
                                                        </t>
                                                        <t t-if="record.partner_city.raw_value">
                                                            <field name="partner_city"/>
                                                        </t>
                                                    </div>
                                                </div>
                                                <div class="o_kanban_record_right ml-2">
                                                    <field name="partner_image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'partner_image', 'size': [60, 60]}"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hostel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hostel.room</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
