<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hostel_room_form" model="ir.ui.view">
        <field name="name">hostel.room.form</field>
        <field name="model">hostel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="room_number"/>
                        <field name="organisation_id"/>
                    </group>
                    <notebook invisible="not id">
                        <page string="Beds">
                            <field name="bed_ids">
                                <kanban>
                                    <field name="partner_id"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click">
                                                <div class="o_kanban_record_top">
                                                    <strong>Resident: <field name="partner_id"/></strong>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hostel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hostel.room</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
