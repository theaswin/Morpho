<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_hostel_root" name="Hostel Management" sequence="10" web_icon="base,static/description/icon.png"/>
    <!-- Kanban View -->
    <record id="view_organisation_kanban" model="ir.ui.view">
        <field name="name">org.organisation.kanban</field>
        <field name="model">org.organisation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0">
                <field name="name"/>
                <field name="location"/>
                <field name="mobile"/>
                <field name="total_rooms"/>
                <field name="total_beds"/>
                <field name="occupied_count"/>
                <field name="vacant_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted mb-2">
                                    <i class="fa fa-map-marker me-1"/><field name="location"/>
                                    <span class="ms-3"><i class="fa fa-phone me-1"/><field name="mobile"/></span>
                                </div>
                                <div class="d-flex justify-content-between mt-2">
                                    <div class="text-center">
                                        <div class="fw-bold text-primary"><field name="total_rooms"/></div>
                                        <small class="text-muted">Rooms</small>
                                    </div>
                                    <div class="text-center">
                                        <div class="fw-bold text-info"><field name="total_beds"/></div>
                                        <small class="text-muted">Beds</small>
                                    </div>
                                    <div class="text-center">
                                        <div class="fw-bold text-danger"><field name="occupied_count"/></div>
                                        <small class="text-muted">Occupied</small>
                                    </div>
                                    <div class="text-center">
                                        <div class="fw-bold text-success"><field name="vacant_count"/></div>
                                        <small class="text-muted">Vacant</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- list View -->
    <record id="view_organisation_list" model="ir.ui.view">
        <field name="name">org.organisation.list</field>
        <field name="model">org.organisation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="location"/>
                <field name="mobile"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_organisation_form" model="ir.ui.view">
        <field name="name">org.organisation.form</field>
        <field name="model">org.organisation</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Organisation Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vat"/>
                            <field name="location"/>
                            <field name="default_message"/>
                        </group>
                        <group>
                            <field name="mobile"/>
                            <field name="owner_id"/>
                            <field name="logo" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'logo', 'size': [128, 128]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="room_ids" context="{'default_organisation_id': id}">
                                <kanban>
                                    <field name="room_number"/>
                                    <field name="vacancy_count"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click oe_kanban_card">
                                                <div class="oe_kanban_content">
                                                    <div class="o_kanban_record_top mb-2">
                                                        <div class="o_kanban_record_headings">
                                                            <strong class="o_kanban_record_title text-primary">
                                                                <i class="fa fa-door-open mr-2"/>
                                                                Room: <field name="room_number"/>
                                                            </strong>
                                                        </div>
                                                    </div>
                                                    <div class="o_kanban_record_body">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="text-muted">
                                                                <i class="fa fa-bed mr-1"/>
                                                                Vacancy
                                                            </div>
                                                            <span t-attf-class="font-weight-bold #{record.vacancy_count.raw_value > 0 ? 'text-success' : 'text-danger'}" style="font-size: 1.1rem;">
                                                                <field name="vacancy_count"/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="room_number"/>
                                        <field name="organisation_id" invisible="1"/>
                                    </group>
                                    <separator string="Beds" invisible="not id"/>
                                    <field name="bed_ids" invisible="not id">
                                        <kanban>
                                            <field name="partner_id"/>
                                            <field name="partner_image"/>
                                            <templates>
                                                <t t-name="card">
                                                    <div class="oe_kanban_global_click oe_kanban_card">
                                                        <div class="oe_kanban_content d-flex align-items-start">
                                                            <div class="o_kanban_image mr-4">
                                                                <field name="partner_image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'partner_image', 'size': [64, 64]}" t-if="record.partner_id.raw_value"/>
                                                                <div t-else="" class="bg-light d-flex align-items-center justify-content-center border rounded" style="width: 64px; height: 64px;">
                                                                    <i class="fa fa-bed fa-2x text-muted"/>
                                                                </div>
                                                            </div>
                                                            <div class="o_kanban_details flex-grow-1">
                                                                <div class="mt-2 mb-2">
                                                                    <t t-if="record.partner_id.raw_value">
                                                                        <i class="fa fa-user mr-1 text-info"/>
                                                                        <strong> Resident : </strong> <field name="partner_id"/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <i class="fa fa-bed mr-1 text-danger"/>
                                                                        <span class="text-danger font-weight-bold"> VACANT </span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_organisation" model="ir.actions.act_window">
        <field name="name">Organisations</field>
        <field name="res_model">org.organisation</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
