<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hostel_bed_form" model="ir.ui.view">
        <field name="name">hostel.bed.form</field>
        <field name="model">hostel.bed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" string="Resident"/>
                        <field name="room_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hostel_bed" model="ir.actions.act_window">
        <field name="name">Beds</field>
        <field name="res_model">hostel.bed</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>
