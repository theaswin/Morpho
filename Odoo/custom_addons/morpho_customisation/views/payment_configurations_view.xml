<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View -->
    <record id="view_pay_conf_list" model="ir.ui.view">
        <field name="name">pay.conf.list</field>
        <field name="model">pay.conf</field>
        <field name="arch" type="xml">
            <list>
                <field name="payment_provider_id"/>
                <field name="key_id"/>
                <field name="key_secret"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_pay_conf_form" model="ir.ui.view">
        <field name="name">pay.conf.form</field>
        <field name="model">pay.conf</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="payment_provider_id"/>
                        <field name="organisation_id"/>
                    </group>
                    <group string="Credentials">
                        <field name="key_id"/>
                        <field name="key_secret" password="True"/>
                    </group>
                    <group string="API Configurations" col="2">
                        <field name="conf_api_1"/>
                        <field name="conf_api_2"/>
                        <field name="conf_api_3"/>
                        <field name="conf_api_4"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pay_conf" model="ir.actions.act_window">
        <field name="name">Payment Configurations</field>
        <field name="res_model">pay.conf</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
