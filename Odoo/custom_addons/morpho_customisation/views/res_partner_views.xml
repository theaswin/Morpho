<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_hostel" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.hostel</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="%(action_partner_whatsapp_wizard)d" string="Send WhatsApp" type="action" class="btn-primary"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_partner_whatsapp_wizard)d" string="WhatsApp" type="action" class="oe_stat_button" icon="fa-whatsapp"/>
            </xpath>
            <xpath expr="//field[@name='function']" position="after">
                <field name="organisation_ids" widget="many2many_tags"  options="{'no_create': True}"/>
                <field name="date_of_joining"/>
                <field name="monthly_fee"/>
                <field name="additional_cost"/>
                <field name="total_cost" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_kanban_inherit_hostel" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit.hostel</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="id"/>
                <field name="display_name"/>
                <field name="email"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="oe_kanban_content d-flex">
                                <div class="o_kanban_image mr-2">
                                    <img t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)" alt="Avatar" class="o_image_64_max oe_avatar"/>
                                </div>
                                <div class="o_kanban_record_top flex-grow-1">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <i class="fa fa-user mr-2 text-primary"/>
                                            <field name="display_name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body mt-1">
                                        <div class="text-muted small" t-if="record.city.raw_value">
                                            <i class="fa fa-map-marker mr-1"/>
                                            <field name="city"/>
                                        </div>
                                        <div class="text-muted small" t-if="record.email.raw_value">
                                            <i class="fa fa-envelope mr-1"/>
                                            <field name="email"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hostel_partner" model="ir.actions.act_window">
        <field name="name">Residents</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('organisation_ids', '!=', False)]</field>
    </record>

    <menuitem id="menu_hostel_partner" name="Residents" parent="menu_hostel_root" action="action_hostel_partner" sequence="20"/>
</odoo>
